# n8n instance must be started with N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# for {{ $env.X }} expressions inside nodes to resolve at all. See README.
#
# The stock database connection (host/port/user/password) lives in n8n's
# own Postgres credential ("Stock DB (local)"), not here -- see README's
# Setup section. This file only lists vars the workflow reads via $env.

