# n8n instance must be started with N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# for {{ $env.X }} expressions inside nodes to resolve at all. See README.

# Google Sheet ID of the fake "stock database" (tabs: Untitled, Routing).
# Found in the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
STOCK_SHEET_ID=

# Recipient of failure-alert emails sent by workflows/ato-expiry-error-handler.json
ALERT_EMAIL_TO=
